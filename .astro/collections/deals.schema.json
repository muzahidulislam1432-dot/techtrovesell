{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "status": {
      "default": "draft",
      "type": "string",
      "enum": [
        "draft",
        "published"
      ]
    },
    "category": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "imageAlt": {
      "default": "",
      "type": "string"
    },
    "excerpt": {
      "type": "string"
    },
    "amazonUrl": {
      "type": "string"
    },
    "dealLabel": {
      "default": "Featured Deal",
      "type": "string"
    },
    "expiryNote": {
      "type": "string"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "slug",
    "category",
    "image",
    "excerpt",
    "amazonUrl"
  ]
}