---
interface Props {
  category: string;
  title: string;
  excerpt: string;
  image: string;
  readTime: string;
}

const { category, title, excerpt, image, readTime } = Astro.props;
---

<article class="article-card">
  <a class="article-art" href="/buying-guides/" aria-label={`Read ${title}`}>
    <img src={image} alt="" width="720" height="430" loading="lazy" />
  </a>
  <div class="article-content">
    <div class="article-meta">
      <span>{category}</span>
      <span>{readTime}</span>
    </div>
    <h3><a href="/buying-guides/">{title}</a></h3>
    <p>{excerpt}</p>
    <a class="text-link" href="/buying-guides/">Read guide <span aria-hidden="true">→</span></a>
  </div>
</article>
