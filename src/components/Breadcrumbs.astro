---
const { items = [] } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/">Home</a>
  {items.map((item, index) => (
    <>
      <span>/</span>
      {index === items.length - 1 ? <span aria-current="page">{item.label}</span> : <a href={item.href}>{item.label}</a>}
    </>
  ))}
</nav>
