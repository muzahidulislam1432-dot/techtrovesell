---
const {
  products = [],
  rows = []
} = Astro.props;
---

<div class="comparison-wrapper">

<table class="comparison-table">

<thead>

<tr>
<th>Feature</th>

{products.map(product => (
<th class={product.score === Math.max(...products.map(p => p.score)) ? "winner-column" : ""}>

  <div class="comparison-header">

    <img
      src={product.image}
      alt={product.name}
      class="comparison-product-image"
    />

    <h3>{product.name}</h3>

<div class="comparison-rating">
  <span class="stars">★★★★★</span>

  <span class="rating-value">
    {product.score}/5
  </span>
</div>

  </div>

</th>
))}

</tr>

</thead>

<tbody>

{rows.map((row) => (
  <tr>
    <td>{row.feature}</td>

    <td>{row.a}</td>

    <td>{row.b}</td>

  </tr>
))}

<tr class="comparison-cta-row">
<td></td>

{products.map(product => (

<td>

<a
href={product.amazon}
class="button button--amazon"
target="_blank"
rel="nofollow sponsored noopener"
>

View Latest Price →

</a>

</td>

))}

</tr>

</tbody>

</table>

</div>

<style>

.comparison-wrapper{
    overflow-x:auto;
    margin:70px 0;
}

.comparison-table{
    width:100%;
    table-layout:fixed;
    border-collapse:separate;
    border-spacing:0;
    overflow:hidden;
    border-radius:18px;
    border:1px solid #e5e7eb;
}

.comparison-table th:first-child,
.comparison-table td:first-child{
    width:180px;
}

.comparison-table th{
    background:#111827;
    color:#fff;
    padding:22px 18px;
    text-align:center;
    vertical-align:middle;
}

.comparison-table td{
    padding:14px 20px;
    border-bottom:1px solid #e5e7eb;
    vertical-align:middle;
    font-size:15px;
}

.comparison-table td:first-child{
    width:230px;
    font-weight:700;
    color:#111827;
    background:#f9fafb;
    white-space:nowrap;
}

.comparison-table td:not(:first-child){
    text-align:center;
    font-weight:600;
    color:#374151;
}

.comparison-table tbody tr:nth-child(even){
    background:#f8fafc;
}

.comparison-table tbody tr:hover{
    background:#edf5ff;
    transition:background .25s ease;
}

.comparison-table th img{
    width:80px;
    height:80px;
    object-fit:contain;
    display:block;
    margin:0 auto 12px;
    background:transparent;
    border:none;
    box-shadow:none;
    padding:0;
}

.comparison-table th h3{
    font-size:1.35rem;
    font-weight:700;
    line-height:1.2;
    margin:8px 0 4px;
    color:#fff;
}

.comparison-table a{
    display:inline-flex;
    align-items:center;
    justify-content:center;

    min-width:190px;
    height:48px;

    padding:0 22px;

    border-radius:10px;

    font-weight:700;

    text-decoration:none;
}

.comparison-table tbody tr:nth-child(even){
    background:#f8fafc;
}

.comparison-header{
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:10px;
    padding:8px 0;
}
.comparison-product-image{
    width:85px;
    height:85px;
    object-fit:contain;
    display:block;
    margin:auto;
}

.comparison-header h3{
    margin:0;
    font-size:1.2rem;
    line-height:1.3;
    font-weight:700;
    color:#fff;
}

.comparison-header .comparison-score{
    margin:0;
    color:#fbbf24;
    font-weight:700;
}

.comparison-rating{

    display:flex;

    flex-direction:column;

    align-items:center;

    gap:6px;

}

.stars{

    color:#f59e0b;

    font-size:20px;

    letter-spacing:2px;

}

.rating-value{

    font-size:15px;

    font-weight:700;

    color:#cbd5e1;

}

.comparison-action{
    background:#fff;
    border:none;
}

/* ===========================
   Winner Column
=========================== */

.winner-column{

    background:linear-gradient(
        180deg,
        #1d4ed8,
        #0f172a
    );

    position:relative;

}

.winner-column::after{

    content:"🏆 BEST";

    position:absolute;

    top:12px;

    right:12px;

    background:#fbbf24;

    color:#111827;

    padding:6px 12px;

    border-radius:999px;

    font-size:12px;

    font-weight:700;

}

@media (max-width:900px){

.comparison-wrapper{

overflow-x:auto;

}

.comparison-table{

min-width:760px;

}

}

.comparison-products{
    margin:70px 0;
}

.article-body{
    margin:70px 0;
}

.comparison-cta-row td{
    background:#fff !important;
    padding:22px 18px;
}

@media (max-width:900px){

.comparison-wrapper{
    overflow-x:auto;
}

.comparison-table{
    min-width:760px;
}

}

</style>