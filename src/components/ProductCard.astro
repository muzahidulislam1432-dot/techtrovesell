---
interface Props {
  title: string;
  eyebrow: string;
  description: string;
  image: string;
  badge?: string;
  features: string[];
}

const { title, eyebrow, description, image, badge, features } = Astro.props;
---

<article class="product-card">
  <div class="product-art">
    {badge && <span class="product-badge">{badge}</span>}
    <img src={image} alt="" width="640" height="460" loading="lazy" />
  </div>

  <div class="product-content">
    <p class="eyebrow">{eyebrow}</p>
    <h3>{title}</h3>
    <p>{description}</p>
    <ul class="feature-list">
      {features.map((feature) => <li>{feature}</li>)}
    </ul>
    <a class="text-link" href="/reviews/">Read the review <span aria-hidden="true">→</span></a>
  </div>
</article>
