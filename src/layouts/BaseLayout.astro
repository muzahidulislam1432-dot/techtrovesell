---
import "../styles/global.css";
const {
  title,
  description,
  canonical = "https://techtrovesell.com/",
  type = "website"
} = Astro.props;

const organizationSchema = {
  "@context":"https://schema.org",
  "@type":"Organization",
  "name":"TechTroveSell",
  "url":"https://techtrovesell.com",
  "description":"Independent technology reviews, comparisons and buying guides."
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#08111f" />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="TechTroveSell" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content="https://techtrovesell.com/images/og-cover.svg" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://techtrovesell.com/images/og-cover.svg" />
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
  <title>{title}</title>
</head>
<body>
  <slot />
</body>
</html>
