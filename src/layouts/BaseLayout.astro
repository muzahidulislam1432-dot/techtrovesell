---
import '../styles/global.css';
import '../styles/hero-custom.css';
const {
  title,
  description,
  canonical = Astro.url.href,
  type = 'website',
  image = 'https://techtrovesell.com/images/techtrovestore-cover.png',
  schema
} = Astro.props;
const baseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'TechTroveSell',
  alternateName: 'TechTroveStore',
  url: 'https://techtrovesell.com',
  logo: 'https://techtrovesell.com/images/techtrovestore-profile.png',
  description: 'Independent technology reviews, comparisons and buying guides.'
};
---
<!doctype html>
<html lang="en">
  <head>
<meta name="twitter:image" content={image} />

<script type="application/ld+json" set:html={JSON.stringify(baseSchema)}></script>
{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>}

<!-- Google Analytics -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-JR53ZZ9LVC"></script>

<script is:inline>
  window.dataLayer = window.dataLayer || [];

  function gtag() {
    dataLayer.push(arguments);
  }

  gtag('js', new Date());

  gtag('config', 'G-JR53ZZ9LVC');
</script>

<title>{title}</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07111f" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/images/techtrovestore-profile.png" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="TechTroveSell" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script type="application/ld+json" set:html={JSON.stringify(baseSchema)}></script>
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
