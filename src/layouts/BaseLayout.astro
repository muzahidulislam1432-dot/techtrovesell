import '../styles/variables.css';
import '../styles/global.css';
import '../styles/header.css';
import '../styles/homepage.css';
import '../styles/review.css';
import '../styles/footer.css';
import '../styles/responsive.css';
import '../styles/hero-custom.css';
---
const {
  title,
  description,
  canonical = Astro.url.href,
  type = 'website',
  image = 'https://techtrovesell.com/images/techtrovestore-cover.png',
  schema
} = Astro.props;
const baseSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://techtrovesell.com/#organization",

  name: "TechTroveSell",
  alternateName: "TechTroveStore",

  url: "https://techtrovesell.com",

  logo: {
    "@type": "ImageObject",
    url: "https://techtrovesell.com/images/techtrovestore-profile.png"
  },

  image: "https://techtrovesell.com/images/techtrovestore-cover.png",

  description:
    "Independent technology reviews, buying guides, product comparisons, AI tools, and Amazon affiliate recommendations.",

  foundingDate: "2026"
};
const websiteSchema = {
  "@context": "https://schema.org",

  "@type": "WebSite",

  "@id": "https://techtrovesell.com/#website",

  url: "https://techtrovesell.com",

  name: "TechTroveSell",

  publisher: {
    "@id": "https://techtrovesell.com/#organization"
  },

  inLanguage: "en"
};
---
<!doctype html>
<html lang="en">
  <head>
<meta name="twitter:image" content={image} />

<!-- Google Analytics -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-JR53ZZ9LVC"></script>

<script is:inline>
  window.dataLayer = window.dataLayer || [];

  function gtag() {
    dataLayer.push(arguments);
  }

  gtag('js', new Date());

  gtag('config', 'G-JR53ZZ9LVC');
</script>
<script type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "xvvyxn8uox");
</script>
<title>{title}</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07111f" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/images/techtrovestore-profile.png" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="TechTroveSell" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script
  type="application/ld+json"
  set:html={JSON.stringify(baseSchema)}
></script>

<script
  type="application/ld+json"
  set:html={JSON.stringify(websiteSchema)}
></script>

{schema && (
  <script
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  ></script>
)}

  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
