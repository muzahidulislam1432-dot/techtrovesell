---
import {getCollection,render} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import Header from '../../components/Header.astro';import Footer from '../../components/Footer.astro';
export async function getStaticPaths(){const entries=(await getCollection('guides')).filter(x=>x.data.status==='published');return entries.map(entry=>({params:{slug:entry.data.slug},props:{entry}}))}const {entry}=Astro.props;const {Content}=await render(entry);const d=entry.data;
---
<BaseLayout title={d.seoTitle||`${d.title} | TechTroveSell`} description={d.seoDescription||d.excerpt} canonical={`https://techtrovesell.com/buying-guides/${d.slug}/`} type="article"><Header/><main><section class="guide-hero"><div class="container review-hero-grid"><div><p class="eyebrow">{d.category} buying guide</p><h1>{d.title}</h1><p class="review-lead">{d.excerpt}</p><span class="review-badge">{d.readTime}</span></div><div class="review-image"><img src={d.image} alt={d.imageAlt}/></div></div></section><section class="section"><article class="container guide-article content-body"><Content/></article></section></main><Footer/></BaseLayout>
