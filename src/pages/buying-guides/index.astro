---
import {getCollection} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import Header from '../../components/Header.astro';import Footer from '../../components/Footer.astro';const entries=(await getCollection('guides')).filter(x=>x.data.status==='published');
---
<BaseLayout title="Buying Guides | TechTroveSell" description="Practical technology buying guides."><Header/><main><section class="archive-hero"><div class="container"><p class="eyebrow">Buying guides</p><h1>Buy Smarter. Choose Better.</h1></div></section><section class="section"><div class="container archive-grid">{entries.map(g=><article class="archive-card"><img src={g.data.image} alt={g.data.imageAlt}/><div><p class="eyebrow">{g.data.category}</p><h2><a href={`/buying-guides/${g.data.slug}/`}>{g.data.title}</a></h2><p>{g.data.excerpt}</p><a class="text-link" href={`/buying-guides/${g.data.slug}/`}>Read guide →</a></div></article>)}</div></section></main><Footer/></BaseLayout>
