---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import guides from "../../data/guides.json";
---
<BaseLayout title="Technology Buying Guides | TechTroveSell" description="Practical technology buying guides.">
  <Header />
  <main>
    <section class="archive-hero">
      <div class="container">
        <Breadcrumbs items={[{label:"Buying Guides",href:"/buying-guides/"}]} />
        <p class="eyebrow">Buying guides</p>
        <h1>Understand what matters before you buy.</h1>
      </div>
    </section>

    <section class="section">
      <div class="container archive-grid">
        {guides.map(g => (
          <article class="archive-card">
            <img src={g.image} alt="" />
            <div>
              <p class="eyebrow">{g.category}</p>
              <h2><a href={`/buying-guides/${g.slug}/`}>{g.title}</a></h2>
              <p>{g.excerpt}</p>
              <a class="text-link" href={`/buying-guides/${g.slug}/`}>Read guide →</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
