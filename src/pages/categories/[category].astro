---
import {getCollection} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import Header from '../../components/Header.astro';import Footer from '../../components/Footer.astro';
export async function getStaticPaths(){const categories=await getCollection('categories');return categories.map(category=>({params:{category:category.data.slug},props:{category}}))}const {category}=Astro.props;const reviews=(await getCollection('reviews')).filter(x=>x.data.status==='published'&&x.data.category===category.data.slug);
---
<BaseLayout title={`${category.data.name} Reviews and Guides | TechTroveSell`} description={category.data.description} canonical={`https://techtrovesell.com/categories/${category.data.slug}/`}><Header/><main><section class="archive-hero"><div class="container"><p class="eyebrow">Category</p><h1>{category.data.icon} {category.data.name}</h1><p>{category.data.description}</p></div></section><section class="section"><div class="container">{reviews.length?<div class="archive-grid">{reviews.map(r=><article class="archive-card"><img src={r.data.image} alt={r.data.imageAlt}/><div><h2><a href={`/reviews/${r.data.slug}/`}>{r.data.title}</a></h2><p>{r.data.excerpt}</p></div></article>)}</div>:<div class="empty-state"><h2>Research is in progress.</h2><p>Add a review in this category through the CMS.</p></div>}</div></section></main><Footer/></BaseLayout>
