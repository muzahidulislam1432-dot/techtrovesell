---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import products from "../../data/products.json";

const categories=[
  {slug:"gaming",label:"Gaming"},
  {slug:"pc-accessories",label:"PC Accessories"},
  {slug:"mobile",label:"Mobile"},
  {slug:"smart-home",label:"Smart Home"},
  {slug:"office",label:"Office"}
];

export function getStaticPaths() {
  return categories.map(category => ({ params:{category:category.slug}, props:{category} }));
}
const { category }=Astro.props;
const matching=products.filter(p=>p.category===category.slug);
---
<BaseLayout title={`${category.label} | TechTroveSell`} description={`${category.label} reviews and buying guides.`}>
  <Header />
  <main>
    <section class="archive-hero">
      <div class="container">
        <Breadcrumbs items={[{label:"Categories",href:"/categories/"},{label:category.label,href:`/categories/${category.slug}/`}]} />
        <p class="eyebrow">Category</p>
        <h1>{category.label}</h1>
      </div>
    </section>

    <section class="section">
      <div class="container">
        {matching.length ? (
          <div class="archive-grid">
            {matching.map(p => (
              <article class="archive-card">
                <img src={p.image} alt="" />
                <div>
                  <h2><a href={`/reviews/${p.slug}/`}>{p.title}</a></h2>
                  <p>{p.summary}</p>
                  <a class="text-link" href={`/reviews/${p.slug}/`}>Read review →</a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <h2>Research is in progress.</h2>
            <p>Original reviews and guides will appear here as they are completed.</p>
          </div>
        )}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
