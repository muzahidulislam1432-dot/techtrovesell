---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
const categories=[
  {slug:"gaming",icon:"🎮",title:"Gaming"},
  {slug:"pc-accessories",icon:"⌨️",title:"PC Accessories"},
  {slug:"mobile",icon:"📱",title:"Mobile"},
  {slug:"smart-home",icon:"🏠",title:"Smart Home"},
  {slug:"office",icon:"💼",title:"Office"}
];
---
<BaseLayout title="Technology Categories | TechTroveSell" description="Browse reviews and buying guides by category.">
  <Header />
  <main>
    <section class="archive-hero">
      <div class="container">
        <Breadcrumbs items={[{label:"Categories",href:"/categories/"}]} />
        <p class="eyebrow">Categories</p>
        <h1>Explore technology by use case.</h1>
      </div>
    </section>
    <section class="section">
      <div class="container category-grid">
        {categories.map(c => (
          <a class="category-card" href={`/categories/${c.slug}/`}>
            <span class="category-icon">{c.icon}</span>
            <strong>{c.title}</strong>
            <span class="category-arrow">→</span>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
