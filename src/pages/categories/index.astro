---
import {getCollection} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import Header from '../../components/Header.astro';import Footer from '../../components/Footer.astro';const categories=(await getCollection('categories')).sort((a,b)=>a.data.order-b.data.order);
---
<BaseLayout title="Product Categories | TechTroveSell" description="Browse reviews and guides by category."><Header/><main><section class="archive-hero"><div class="container"><p class="eyebrow">Categories</p><h1>Explore technology by use case.</h1></div></section><section class="section"><div class="container category-grid">{categories.map(c=><a class="category-card" href={`/categories/${c.data.slug}/`}><span class="category-icon">{c.data.icon}</span><strong>{c.data.name}</strong><small>{c.data.description}</small><span class="category-arrow">→</span></a>)}</div></section></main><Footer/></BaseLayout>
