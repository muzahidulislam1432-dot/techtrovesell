---
import { getCollection, render } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ComparisonTable from "../../components/ComparisonTable.astro";

export async function getStaticPaths() {

  const entries = (await getCollection("comparisons"))
    .filter(x => x.data.status === "published");

  return entries.map(entry => ({
    params: {
      slug: entry.data.slug
    },
    props: {
      entry
    }
  }));

}

const { entry } = Astro.props;

const { Content } = await render(entry);

const d = entry.data;
---

<BaseLayout
  title={d.seoTitle || `${d.title} | TechTroveSell`}
  description={d.seoDescription || d.excerpt}
  canonical={`https://techtrovesell.com/comparisons/${d.slug}/`}
  type="article"
>

<Header />

<main id="main-content">

<!-- ======================================
     HERO
====================================== -->

<section class="article-hero">

  <div class="container">

    <p class="eyebrow">
      {d.category} Comparison
    </p>

    <h1>{d.productA} vs {d.productB}</h1>

    <p class="article-summary">
      {d.excerpt}
    </p>

  </div>

</section>


<!-- ======================================
     QUICK RESULT
====================================== -->

<section class="comparison-winner">

  <div class="container">

    <div class="review-panel">

      <p class="eyebrow">
        Quick Result
      </p>

      <h2>Winner</h2>

      <p>{d.winner}</p>

    </div>

  </div>

</section>


<!-- ======================================
     COMPARISON TABLE
====================================== -->

<section class="comparison-table-section">

  <div class="container">

<ComparisonTable
  title="Feature Comparison"
  products={d.products}
/>

  </div>

</section>


    <!-- ======================================
         COMPARISON TABLE
    ======================================= -->

    <section class="comparison-table-section">

      <div class="container">

        <div class="review-panel">

          <h2>
            Feature Comparison
          </h2>

          <table class="comparison-table">

            <thead>

              <tr>

                <th>Feature</th>

                <th>{d.productA}</th>

                <th>{d.productB}</th>

              </tr>

            </thead>

            <tbody>

              {d.rows.map((r) => (

                <tr>

                  <td>{r.feature}</td>

                  <td>{r.a}</td>

                  <td>{r.b}</td>

                </tr>

              ))}

            </tbody>

          </table>

        </div>

      </div>

    </section>

<!-- ======================================
     ARTICLE
====================================== -->

<section class="article-body">

  <div class="container">

    <div class="review-panel content-body">

      <Content />

    </div>

  </div>

</section>

</main>

<Footer />

</BaseLayout>
