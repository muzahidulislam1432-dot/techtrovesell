---

<BaseLayout
  title={d.seoTitle || `${d.title} | TechTroveSell`}
  description={d.seoDescription || d.excerpt}
  canonical={`https://techtrovesell.com/comparisons/${d.slug}/`}
  type="article"
>

  <main id="main-content">

    <!-- ======================================
         HERO
    ======================================= -->

    <section class="article-hero">

      <div class="container">

        <p class="eyebrow">
          {d.category} Comparison
        </p>

        <h1>
          {d.productA} vs {d.productB}
        </h1>

        <p class="article-summary">
          {d.excerpt}
        </p>

      </div>

    </section>


    <!-- ======================================
         QUICK RESULT
    ======================================= -->

    <section class="comparison-winner">

      <div class="container">

        <div class="review-panel">

          <p class="eyebrow">
            Quick Result
          </p>

          <h2>
            Winner
          </h2>

          <p>
            {d.winner}
          </p>

        </div>

      </div>

    </section>


    <!-- ======================================
         COMPARISON TABLE
    ======================================= -->

    <section class="comparison-table-section">

      <div class="container">

        <div class="review-panel">

          <h2>
            Feature Comparison
          </h2>

          <table class="comparison-table">

            <thead>

              <tr>

                <th>Feature</th>

                <th>{d.productA}</th>

                <th>{d.productB}</th>

              </tr>

            </thead>

            <tbody>

              {d.rows.map((r) => (

                <tr>

                  <td>{r.feature}</td>

                  <td>{r.a}</td>

                  <td>{r.b}</td>

                </tr>

              ))}

            </tbody>

          </table>

        </div>

      </div>

    </section>

  </main>

</BaseLayout>
