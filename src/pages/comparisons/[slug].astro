---
import { getCollection, getEntry, render } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ComparisonTable from "../../components/ComparisonTable.astro";

export async function getStaticPaths() {
  const entries = (await getCollection("comparisons"))
    .filter((x) => x.data.status === "published");

  return entries.map((entry) => ({
    params: {
      slug: entry.data.slug,
    },
    props: {
      entry,
    },
  }));
}

const { entry } = Astro.props;

const { Content } = await render(entry);

const d = entry.data;
const relatedEntries = await Promise.all(
  (d.relatedComparisons || []).map(async (slug) => {
    const item = await getEntry("comparisons", slug);
    return item;
  })
);
---
<BaseLayout
  title={d.seoTitle || `${d.title} | TechTroveSell`}
  description={d.seoDescription || d.excerpt}
  canonical={`https://techtrovesell.com/comparisons/${d.slug}/`}
  type="article"
>

<Header />

<main id="main-content">

  <!-- HERO -->

  <section class="article-hero">

    <div class="container">

      <p class="eyebrow">
        {d.category} Comparison
      </p>

     <h1 class="comparison-title">
  {d.products[0].name} vs {d.products[1].name}
</h1>

      <p class="comparison-summary">
        {d.excerpt}
      </p>

      {
  d.heroImage && (
    <div class="comparison-hero-image">
      <img
        src={d.heroImage}
        alt={d.heroImageAlt || d.title}
        loading="eager"
      />
    </div>
  )
}

    </div>

  </section>


  <!-- PRODUCT CARDS -->

  <section class="comparison-products">

<div class="container">

  <div class="comparison-hero">

    {d.products.map((product) => (

      <article class="comparison-card">

        <img
          src={product.image}
          alt={product.name}
          class="comparison-image"
        />

        <div class="comparison-content">

          <h2>{product.name}</h2>

          <div class="comparison-score">
            ⭐ {product.score}/5
          </div>

          {product.price && (
            <div class="comparison-price">
              {product.price}
            </div>
          )}

          {product.tagline && (
            <p class="comparison-tagline">
              {product.tagline}
            </p>
          )}

          {product.pros.length > 0 && (
  <div class="comparison-pros">

    <h4>✔ Pros</h4>

    <ul>

      {product.pros.map((pro) => (
        <li>{pro}</li>
      ))}

    </ul>

  </div>
)}

{product.cons.length > 0 && (
  <div class="comparison-cons">

    <h4>✖ Cons</h4>

    <ul>

      {product.cons.map((con) => (
        <li>{con}</li>
      ))}

    </ul>

  </div>
)}

          <a
            href={product.amazon}
            class="button button--amazon"
            target="_blank"
            rel="nofollow sponsored noopener"
          >
            Check Amazon Price
          </a>

        </div>

      </article>

    ))}

  </div>

</div>

  </section>


  <!-- WINNER -->

<section class="comparison-winner">

  <div class="container">

    <div class="winner-card">

      <div class="winner-badge">
        🏆 Quick Verdict
      </div>

<h2 class="winner-title">
  {d.winnerTitle || d.winner}
</h2>

      <div class="winner-score">
        ⭐ {d.products[0].score}/5
      </div>

<p class="winner-text">
  {d.winnerText}
</p>

<ul class="winner-list">

{d.winnerPros.map((item) => (

<li>✔ {item}</li>

))}

</ul>

      <a
        href={d.products[0].amazon}
        class="button button--amazon"
        target="_blank"
        rel="nofollow sponsored noopener"
      >
        Check Amazon Price
      </a>

    </div>

  </div>

</section>


  <!-- COMPARISON TABLE -->

  <section class="comparison-table-section">

    <div class="container">

      <ComparisonTable
  products={d.products}
  rows={d.rows}
/>

    </div>

  </section>


  <!-- ARTICLE -->

  <section class="article-body">

    <div class="container">

      <div class="review-panel content-body">

        <Content />

      </div>

    </div>

  </section>

  {d.faqs.length > 0 && (

<section class="comparison-faq">

<div class="container">

<h2 class="section-title">
Frequently Asked Questions
</h2>

<div class="faq-list">

{d.faqs.map((faq) => (

<details class="faq-item">

<summary>

{faq.question}

</summary>

<p>

{faq.answer}

</p>

</details>

))}

</div>

</div>

</section>

)}

{relatedEntries.length > 0 && (

<section class="related-comparisons">

<div class="container">

<h2 class="section-title">
Related Comparisons
</h2>

<div class="related-grid">

{relatedEntries.map((item) => (

item && (

<a
href={`/comparisons/${item.data.slug}/`}
class="related-card"
>

<img
src={item.data.heroImage}
alt={item.data.title}
/>

<h3>

{item.data.title}

</h3>

<p>

{item.data.excerpt}

</p>

</a>

)

))}

</div>

</div>

</section>

)}

  </main>

<Footer />

</BaseLayout>


<style>

.comparison-hero{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:32px;
    margin:48px 0;
}

.comparison-card{
    display:flex;
    align-items:center;
    gap:24px;
    background:#fff;
    border:1px solid #e5e7eb;
    border-radius:18px;
    padding:24px;
    box-shadow:0 8px 24px rgba(0,0,0,.05);
}

.comparison-image{
    width:170px;
    height:170px;
    object-fit:contain;
    flex-shrink:0;
}

.comparison-content h2{
    font-size:1.8rem;
    line-height:1.15;
    margin-bottom:10px;
    white-space:nowrap;
}

.comparison-score{
    font-size:20px;
    font-weight:700;
    color:#f59e0b;
}

.comparison-price{
    font-size:26px;
    font-weight:800;
    margin:10px 0;
}

.comparison-tagline{
    margin:12px 0 20px;
    color:#555;
}

.comparison-title{
    font-size:clamp(2.6rem, 4vw, 3.6rem);
    line-height:1.08;
    font-weight:800;
    max-width:none;
    white-space:nowrap;
    letter-spacing:-0.03em;
    margin-bottom:18px;
}

@media (max-width:900px){

.comparison-hero{
grid-template-columns:1fr;
}

.comparison-card{
flex-direction:column;
text-align:center;
}

.comparison-image{
    width:180px;
    height:180px;
}

.comparison-title{
    font-size:2.2rem;
    line-height:1.15;
    white-space:normal;
}

.comparison-summary{
    font-size:1rem;
}

}

/* ===== HERO ===== */

.article-hero .container{
    max-width:1380px;
}

.comparison-title{
    font-size:clamp(2.3rem,3.5vw,3.2rem);
    line-height:1.08;
    font-weight:800;
    white-space:nowrap;
    margin-bottom:14px;
}

.comparison-summary{
    max-width:none;
    font-size:1.08rem;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
    color:#4b5563;
}

.article-hero{
    padding:40px 0 35px;
}

.winner-card{
    background:#fff;
    border:1px solid #e5e7eb;
    border-radius:20px;
    padding:40px;
    margin:40px 0;
    box-shadow:0 10px 25px rgba(0,0,0,.05);
}

.winner-badge{
    display:inline-block;
    background:#eef6ff;
    color:#2563eb;
    font-weight:700;
    padding:8px 18px;
    border-radius:999px;
    margin-bottom:18px;
}

.winner-title{
    font-size:2rem;
    margin:0 0 12px;
}

.winner-score{
    color:#f59e0b;
    font-size:1.3rem;
    font-weight:700;
    margin-bottom:18px;
}

.winner-text{
    color:#555;
    max-width:650px;
    margin-bottom:20px;
}

.winner-list{
    margin:0 0 28px;
    padding-left:20px;
}

.winner-list li{
    margin-bottom:10px;
}

.comparison-hero-image{
    margin-top:40px;
}

.comparison-hero-image img{
    width:100%;
    border-radius:22px;
    display:block;
    box-shadow:0 18px 45px rgba(0,0,0,.12);
}

.comparison-pros,
.comparison-cons{

    margin:18px 0;

}

.comparison-pros h4{

    color:#16a34a;

    margin-bottom:10px;

    font-size:15px;

}

.comparison-cons h4{

    color:#dc2626;

    margin-bottom:10px;

    font-size:15px;

}

.comparison-pros ul,
.comparison-cons ul{

    margin:0;

    padding-left:18px;

}

.comparison-pros li,
.comparison-cons li{

    margin-bottom:8px;

    color:#4b5563;

}

/* ===========================
   FAQ SECTION
=========================== */

.comparison-faq{

margin:80px 0;

}

.faq-list{

display:flex;

flex-direction:column;

gap:18px;

}

.faq-item{

border:1px solid #e5e7eb;

border-radius:16px;

padding:18px 22px;

background:#fff;

}

.faq-item summary{

cursor:pointer;

font-weight:700;

font-size:18px;

color:#111827;

}

.faq-item p{

margin-top:16px;

line-height:1.7;

color:#4b5563;

}

/* ===========================
   RELATED COMPARISONS
=========================== */

.related-comparisons{

margin:90px 0;

}

.related-grid{

display:grid;

grid-template-columns:repeat(auto-fit,minmax(320px,1fr));

gap:28px;

}

.related-card{

display:block;

background:#fff;

border:1px solid #e5e7eb;

border-radius:18px;

overflow:hidden;

text-decoration:none;

transition:.25s;

}

.related-card:hover{

transform:translateY(-6px);

box-shadow:0 18px 35px rgba(0,0,0,.08);

}

.related-card img{

width:100%;

aspect-ratio:16/9;

object-fit:cover;

}

.related-card h3{

padding:20px 20px 10px;

color:#111827;

}

.related-card p{

padding:0 20px 24px;

color:#6b7280;

}

</style>
