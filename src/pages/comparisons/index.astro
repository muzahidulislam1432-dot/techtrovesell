---
import {getCollection} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import Header from '../../components/Header.astro';import Footer from '../../components/Footer.astro';const entries=(await getCollection('comparisons')).filter(x=>x.data.status==='published');
---
<BaseLayout title="Product Comparisons | TechTroveSell" description="Side-by-side technology comparisons."><Header/><main><section class="archive-hero"><div class="container"><p class="eyebrow">Comparisons</p><h1>Compare products side by side.</h1></div></section><section class="section"><div class="container comparison-grid">{entries.map(c=><article class="comparison-card"><span>{c.data.category}</span><h2>{c.data.productA} <em>vs</em> {c.data.productB}</h2><p>{c.data.excerpt}</p><a class="text-link" href={`/comparisons/${c.data.slug}/`}>View comparison →</a></article>)}</div></section></main><Footer/></BaseLayout>
