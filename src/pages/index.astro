---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProductCard from "../components/ProductCard.astro";
import ArticleCard from "../components/ArticleCard.astro";

const categories = [
  { icon: "🎮", title: "Gaming", text: "Controllers, headsets and accessories" },
  { icon: "⌨️", title: "PC accessories", text: "Keyboards, mice, hubs and more" },
  { icon: "📱", title: "Mobile", text: "Chargers, stands and smart add-ons" },
  { icon: "🏠", title: "Smart home", text: "Useful connected-home essentials" },
  { icon: "💼", title: "Office", text: "Practical tools for productive desks" }
];

const products = [
  {
    title: "Wireless Multi-Platform Controller",
    eyebrow: "Gaming pick",
    description: "A practical starting point for shoppers comparing flexible controllers for console and PC play.",
    image: "/images/controller.svg",
    badge: "Reader favorite",
    features: ["Comfort-focused shape", "Programmable controls", "Rechargeable design"]
  },
  {
    title: "Compact Mechanical Keyboard",
    eyebrow: "Desk upgrade",
    description: "A space-saving keyboard concept for gamers and home-office users who value a tidy setup.",
    image: "/images/keyboard.svg",
    badge: "Top value",
    features: ["Compact footprint", "Tactile key layout", "Desk-friendly cable routing"]
  },
  {
    title: "USB-C Desktop Hub",
    eyebrow: "Work essential",
    description: "A simple connectivity upgrade for laptops that need more ports at a shared or permanent desk.",
    image: "/images/hub.svg",
    badge: "Editor's pick",
    features: ["Multiple connection types", "Portable metal body", "Single-cable convenience"]
  }
];

const articles = [
  {
    category: "Buying guide",
    title: "How to choose a wireless gaming controller",
    excerpt: "Compatibility, ergonomics, battery life and control layout explained without unnecessary jargon.",
    image: "/images/guide-controller.svg",
    readTime: "7 min read"
  },
  {
    category: "Comparison",
    title: "Compact keyboards: what size is right for you?",
    excerpt: "Understand full-size, TKL, 75% and 60% layouts before changing your everyday typing setup.",
    image: "/images/guide-keyboard.svg",
    readTime: "6 min read"
  },
  {
    category: "Buying guide",
    title: "A practical guide to USB-C hubs",
    excerpt: "Learn which ports matter and which specifications deserve closer attention before buying.",
    image: "/images/guide-hub.svg",
    readTime: "8 min read"
  }
];
---

<BaseLayout
  title="TechTroveSell | Smarter Tech Reviews and Buying Guides"
  description="Independent technology reviews, comparisons and practical buying guides for gaming, PC, mobile, smart-home and office products."
>
  <Header />

  <main>
    <section class="hero">
      <div class="hero-glow hero-glow--one"></div>
      <div class="hero-glow hero-glow--two"></div>

      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="pill">Smarter tech shopping starts here</span>
          <h1>Find the right tech without the <span>guesswork.</span></h1>
          <p>
            Independent product research, easy-to-follow comparisons and practical buying advice for everyday technology.
          </p>

          <div class="hero-actions">
            <a class="button button--primary" href="#top-picks">Explore top picks</a>
            <a class="button button--ghost" href="#guides">Read buying guides</a>
          </div>

          <div class="trust-row" aria-label="Editorial commitments">
            <span>✓ Clear recommendations</span>
            <span>✓ Honest limitations</span>
            <span>✓ No fake reviews</span>
          </div>
        </div>

        <div class="hero-visual" aria-label="Technology buying guide illustration">
          <div class="visual-card visual-card--main">
            <span class="visual-label">Featured guide</span>
            <img src="/images/hero-tech.svg" alt="" width="760" height="570" />
            <div class="visual-copy">
              <strong>Better choices, clearly explained</strong>
              <span>Compare what matters before you click.</span>
            </div>
          </div>

          <div class="floating-card floating-card--rating">
            <span class="floating-icon">✓</span>
            <div><strong>Research-led</strong><small>Useful, transparent advice</small></div>
          </div>

          <div class="floating-card floating-card--guide">
            <span class="floating-icon">↗</span>
            <div><strong>Buyer focused</strong><small>Built for real decisions</small></div>
          </div>
        </div>
      </div>
    </section>

    <section class="category-section" id="categories">
      <div class="container">
        <div class="section-heading section-heading--split">
          <div>
            <p class="eyebrow">Browse by category</p>
            <h2>Start with what you need</h2>
          </div>
          <p>Focused recommendations across the technology categories people shop most often.</p>
        </div>

        <div class="category-grid">
          {categories.map((category) => (
            <a class="category-card" href="/categories/">
              <span class="category-icon">{category.icon}</span>
              <strong>{category.title}</strong>
              <small>{category.text}</small>
              <span class="category-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--soft" id="top-picks">
      <div class="container">
        <div class="section-heading section-heading--split">
          <div>
            <p class="eyebrow">Featured recommendations</p>
            <h2>Top picks worth comparing</h2>
          </div>
          <p>Phase 1 uses original placeholder artwork. Final products and claims will be added only after research.</p>
        </div>

        <div class="product-grid">
          {products.map((product) => <ProductCard {...product} />)}
        </div>
      </div>
    </section>

    <section class="section editorial-section" id="reviews">
      <div class="container editorial-grid">
        <div class="editorial-visual">
          <img src="/images/editorial.svg" alt="" width="800" height="650" loading="lazy" />
          <span class="editorial-stamp">Built for clarity</span>
        </div>

        <div class="editorial-copy">
          <p class="eyebrow">Our editorial approach</p>
          <h2>Recommendations that explain the “why.”</h2>
          <p>
            TechTroveSell is being built around useful research—not copied product descriptions or unsupported claims.
          </p>

          <div class="principle-list">
            <div>
              <span>01</span>
              <div><strong>Research the decision</strong><p>Identify the features, limitations and trade-offs that matter to the intended buyer.</p></div>
            </div>
            <div>
              <span>02</span>
              <div><strong>Compare honestly</strong><p>Explain where a product fits and where another option may make more sense.</p></div>
            </div>
            <div>
              <span>03</span>
              <div><strong>Disclose clearly</strong><p>Affiliate relationships are shown openly and never disguised as editorial independence.</p></div>
            </div>
          </div>

          <a class="button button--dark" href="/about/">Learn about our process</a>
        </div>
      </div>
    </section>

    <section class="section section--soft" id="guides">
      <div class="container">
        <div class="section-heading section-heading--split">
          <div>
            <p class="eyebrow">Latest learning center</p>
            <h2>Buying guides made practical</h2>
          </div>
          <a class="text-link" href="/buying-guides/">View all guides <span aria-hidden="true">→</span></a>
        </div>

        <div class="article-grid">
          {articles.map((article) => <ArticleCard {...article} />)}
        </div>
      </div>
    </section>

    <section class="newsletter">
      <div class="container newsletter-shell">
        <div>
          <p class="eyebrow">TechTrove briefing</p>
          <h2>Get smarter buying advice in your inbox.</h2>
          <p>Newsletter functionality will be connected in a later phase.</p>
        </div>
        <form class="newsletter-form" action="#" method="post" onsubmit="return false">
          <label class="sr-only" for="email">Email address</label>
          <input id="email" type="email" placeholder="you@example.com" autocomplete="email" />
          <button class="button button--primary" type="submit">Join the list</button>
        </form>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
