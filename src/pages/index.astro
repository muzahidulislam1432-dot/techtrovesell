---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';import Header from '../components/Header.astro';import Footer from '../components/Footer.astro';
const [settingsEntry]=await getCollection('settings'); const settings=settingsEntry.data;
const categories=(await getCollection('categories')).sort((a,b)=>a.data.order-b.data.order);
const reviews=(await getCollection('reviews')).filter(x=>x.data.status==='published');
const guides=(await getCollection('guides')).filter(x=>x.data.status==='published');
const comparisons=(await getCollection('comparisons')).filter(x=>x.data.status==='published');
---
<BaseLayout title={settings.homepageTitle} description={settings.homepageDescription}><Header/><main>
<section class="hero"><div class="container hero-grid"><div><span class="pill">Smarter tech shopping starts here</span><h1>{settings.heroHeading}</h1><p>{settings.heroText}</p><div class="hero-actions"><a class="button button--primary" href={settings.primaryCtaUrl}>{settings.primaryCtaText}</a><a class="button button--ghost" href="/buying-guides/">Read buying guides</a></div><div class="trust-row"><span>✓ No fake reviews</span><span>✓ Clear affiliate disclosure</span><span>✓ Editable through CMS</span></div></div><div class="hero-card"><img src={settings.heroImage} alt={`${settings.socialBrandName} technology banner`}/><div><strong>Professional affiliate publishing</strong><span>Manage reviews, guides, comparisons, deals, images and policies from the CMS.</span></div></div></div></section>
<section class="section"><div class="container"><div class="section-heading"><p class="eyebrow">Categories</p><h2>Start with what you need</h2></div><div class="category-grid">{categories.map(c=><a class="category-card" href={`/categories/${c.data.slug}/`}><span class="category-icon">{c.data.icon}</span><strong>{c.data.name}</strong><small>{c.data.description}</small><span class="category-arrow">→</span></a>)}</div></div></section>
<section class="section section--soft"><div class="container"><div class="section-heading"><p class="eyebrow">Latest reviews</p><h2>Professional product pages</h2></div><div class="archive-grid">{reviews.slice(0,6).map(r=><article class="archive-card"><img src={r.data.image} alt={r.data.imageAlt}/><div><p class="eyebrow">{r.data.category}</p><h2><a href={`/reviews/${r.data.slug}/`}>{r.data.title}</a></h2><p>{r.data.excerpt}</p><a class="text-link" href={`/reviews/${r.data.slug}/`}>Read review →</a></div></article>)}</div></div></section>
<section class="section"><div class="container"><div class="section-heading"><p class="eyebrow">Buying guides</p><h2>Understand what matters</h2></div><div class="archive-grid">{guides.map(g=><article class="archive-card"><img src={g.data.image} alt={g.data.imageAlt}/><div><p class="eyebrow">{g.data.category}</p><h2><a href={`/buying-guides/${g.data.slug}/`}>{g.data.title}</a></h2><p>{g.data.excerpt}</p><a class="text-link" href={`/buying-guides/${g.data.slug}/`}>Read guide →</a></div></article>)}</div></div></section>
<section class="section section--soft"><div class="container"><div class="section-heading"><p class="eyebrow">Comparisons</p><h2>Side-by-side decisions</h2></div><div class="comparison-grid">{comparisons.map(c=><article class="comparison-card"><span>{c.data.category}</span><h2>{c.data.productA} <em>vs</em> {c.data.productB}</h2><p>{c.data.excerpt}</p><a class="text-link" href={`/comparisons/${c.data.slug}/`}>View comparison →</a></article>)}</div></div></section>
</main><Footer/></BaseLayout>
