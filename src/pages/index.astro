---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const [settingsEntry] = await getCollection('settings');
const settings = settingsEntry.data;
const categories = (await getCollection('categories')).sort((a,b) => a.data.order - b.data.order);
const reviews = (await getCollection('reviews')).filter(x => x.data.status === 'published');
const guides = (await getCollection('guides')).filter(x => x.data.status === 'published');
const comparisons = (await getCollection('comparisons')).filter(x => x.data.status === 'published');
const deals = (await getCollection('deals')).filter(x => x.data.status === 'published');
const leadReview = reviews[0];
---
<BaseLayout title={settings.homepageTitle} description={settings.homepageDescription} canonical="https://techtrovesell.com/">
  <Header />
  <main id="main-content">
    <section class="hero-publication">
      <div class="container hero-publication-grid">
        <div class="hero-copy">
          <p class="kicker">Independent reviews • Practical comparisons</p>
<h1 class="hero-title">
  <span class="title-black">Smart tech.</span>
  <span class="title-orange">Honest reviews.</span>
  <span class="title-blue">Better choice.</span>
</h1>
          <p class="hero-summary">{settings.heroText}</p>
          <div class="hero-actions">
            <a class="button button--primary" href={settings.primaryCtaUrl}>{settings.primaryCtaText}</a>
            <a class="button button--secondary" href="/buying-guides/">Browse buying guides</a>
          </div>
          <div class="editorial-promises">
            <span><b>01</b> Clear methodology</span>
            <span><b>02</b> Honest limitations</span>
            <span><b>03</b> Transparent affiliate links</span>
          </div>
        </div>
        <div class="hero-visual">
          <img src={settings.heroImage} alt="TechTroveSell technology review publication" />
        </div>
      </div>
    </section>

    <section class="topic-strip" aria-label="Popular categories">
      <div class="container topic-strip-inner">
        <span class="topic-label">Explore:</span>
        {categories.slice(0, 8).map(c => <a href={`/categories/${c.data.slug}/`}>{c.data.icon} {c.data.name}</a>)}
      </div>
    </section>

    <section class="section editorial-section">
      <div class="container">
        <div class="section-heading section-heading--split"><div><p class="eyebrow">Editor’s desk</p><h2>Featured technology coverage</h2></div><a class="section-link" href="/reviews/">All reviews →</a></div>
        {leadReview ? <div class="lead-story-grid">
          <a class="lead-story-image" href={`/reviews/${leadReview.data.slug}/`}><img src={leadReview.data.image} alt={leadReview.data.imageAlt} /></a>
          <div class="lead-story-copy"><span class="story-label">Featured review</span><h3><a href={`/reviews/${leadReview.data.slug}/`}>{leadReview.data.title}</a></h3><p>{leadReview.data.excerpt}</p><div class="story-meta"><span>{leadReview.data.category}</span><span>Independent analysis</span></div><a class="text-link" href={`/reviews/${leadReview.data.slug}/`}>Read the full review →</a></div>
        </div> : <div class="empty-state"><h3>Your featured review will appear here.</h3><p>Publish a review in the CMS to populate this section automatically.</p></div>}
      </div>
    </section>

    <section class="section section--ink">
      <div class="container">
        <div class="section-heading section-heading--light"><p class="eyebrow">Browse by category</p><h2>Find the right starting point.</h2><p>Explore focused coverage built around the type of technology you are shopping for.</p></div>
        <div class="category-grid publication-category-grid">
          {categories.map(c => <a class="category-card publication-category" href={`/categories/${c.data.slug}/`}><span class="category-icon">{c.data.icon}</span><span><strong>{c.data.name}</strong><small>{c.data.description}</small></span><span class="category-arrow">↗</span></a>)}
        </div>
      </div>
    </section>

    <section class="section section--soft">
      <div class="container">
        <div class="section-heading section-heading--split"><div><p class="eyebrow">Latest reviews</p><h2>Products, explained without the hype.</h2></div><a class="section-link" href="/reviews/">View all reviews →</a></div>
        <div class="story-card-grid">
          {reviews.slice(0,6).map(r => <article class="story-card"><a class="story-card-image" href={`/reviews/${r.data.slug}/`}><img src={r.data.image} alt={r.data.imageAlt}/></a><div class="story-card-body"><span class="story-label">{r.data.category}</span><h3><a href={`/reviews/${r.data.slug}/`}>{r.data.title}</a></h3><p>{r.data.excerpt}</p><a class="text-link" href={`/reviews/${r.data.slug}/`}>Read review →</a></div></article>)}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container editorial-columns">
        <div>
          <div class="section-heading"><p class="eyebrow">Buying guides</p><h2>What matters before you buy.</h2></div>
          <div class="stacked-stories">{guides.slice(0,4).map(g => <article class="stacked-story"><img src={g.data.image} alt={g.data.imageAlt}/><div><span class="story-label">{g.data.category} • {g.data.readTime}</span><h3><a href={`/buying-guides/${g.data.slug}/`}>{g.data.title}</a></h3><p>{g.data.excerpt}</p></div></article>)}</div>
          <a class="button button--secondary" href="/buying-guides/">See all buying guides</a>
        </div>
        <aside class="comparison-rail">
          <div class="section-heading"><p class="eyebrow">Head-to-head</p><h2>Quick comparisons</h2></div>
          {comparisons.slice(0,4).map(c => <article class="comparison-mini"><span>{c.data.category}</span><h3><a href={`/comparisons/${c.data.slug}/`}>{c.data.productA} <em>vs</em> {c.data.productB}</a></h3><p>{c.data.winner}</p></article>)}
          <a class="section-link" href="/comparisons/">All comparisons →</a>
        </aside>
      </div>
    </section>

    <section class="section newsletter-section">
      <div class="container newsletter-card">
        <div><p class="eyebrow">The TechTrove brief</p><h2>Smarter technology decisions, delivered clearly.</h2><p>Use this section later for your email newsletter. Until then, it reinforces the publication’s editorial mission.</p></div>
        <a class="button button--primary" href="/about/">Meet the publication</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
