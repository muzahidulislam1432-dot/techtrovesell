---
import {getCollection,render} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import Header from '../../components/Header.astro';import Footer from '../../components/Footer.astro';import Breadcrumbs from '../../components/Breadcrumbs.astro';
export async function getStaticPaths(){const entries=(await getCollection('reviews')).filter(x=>x.data.status==='published');return entries.map(entry=>({params:{slug:entry.data.slug},props:{entry}}))}
const {entry}=Astro.props;const {Content}=await render(entry);const d=entry.data;
---
<BaseLayout title={d.seoTitle||`${d.title} Review | TechTroveSell`} description={d.seoDescription||d.excerpt} canonical={`https://techtrovesell.com/reviews/${d.slug}/`} type="article"><Header/><main><section class="review-hero"><div class="container"><Breadcrumbs items={[{label:'Reviews',href:'/reviews/'},{label:d.title,href:`/reviews/${d.slug}/`}]}/></div><div class="container review-hero-grid"><div><p class="eyebrow">{d.category} review</p><span class="review-badge">{d.badge}</span><h1>{d.title}</h1><p class="review-lead">{d.excerpt}</p><div class="hero-actions"><a class="button button--primary" href={d.amazonUrl} rel="nofollow sponsored noopener">Check price on Amazon</a><a class="button button--ghost" href="#verdict">Read verdict</a></div><p class="inline-disclosure">As an Amazon Associate, we earn from qualifying purchases.</p></div><div class="review-image"><img src={d.image} alt={d.imageAlt}/></div></div></section><section class="section"><div class="container review-layout"><article><section class="review-panel" id="verdict"><p class="eyebrow">Quick verdict</p><h2>{d.verdict}</h2></section><section class="pros-cons-grid"><div class="review-panel pros-panel"><h2>Pros</h2><ul>{d.pros.map(x=><li>{x}</li>)}</ul></div><div class="review-panel cons-panel"><h2>Cons</h2><ul>{d.cons.map(x=><li>{x}</li>)}</ul></div></section><section class="review-panel"><h2>Key features</h2><ul>{d.features.map(x=><li>{x}</li>)}</ul></section><section class="review-panel"><h2>Specifications</h2><div class="spec-table">{d.specs.map(x=><div><strong>{x.label}</strong><span>{x.value}</span></div>)}</div></section><section class="review-panel"><h2>Who should consider it</h2><p>{d.bestFor}</p></section><section class="review-panel"><h2>Who should avoid it</h2><p>{d.avoidIf}</p></section><section class="review-panel content-body"><Content/></section></article><aside><div class="sticky-card"><img src={d.image} alt={d.imageAlt}/><h2>{d.title}</h2><p>{d.excerpt}</p><a class="button button--primary button--full" href={d.amazonUrl} rel="nofollow sponsored noopener">Check price on Amazon</a></div></aside></div></section></main><Footer/></BaseLayout>
