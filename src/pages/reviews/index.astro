---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import products from "../../data/products.json";
---
<BaseLayout title="Technology Reviews | TechTroveSell" description="Browse clear technology reviews from TechTroveSell.">
  <Header />
  <main>
    <section class="archive-hero">
      <div class="container">
        <Breadcrumbs items={[{label:"Reviews",href:"/reviews/"}]} />
        <p class="eyebrow">Reviews</p>
        <h1>Product reviews that explain the trade-offs.</h1>
        <p>Sample pages demonstrate our review structure. Final recommendations will be researched individually.</p>
      </div>
    </section>

    <section class="section">
      <div class="container archive-grid">
        {products.map(p => (
          <article class="archive-card">
            <img src={p.image} alt="" />
            <div>
              <p class="eyebrow">{p.categoryLabel}</p>
              <h2><a href={`/reviews/${p.slug}/`}>{p.title}</a></h2>
              <p>{p.summary}</p>
              <a class="text-link" href={`/reviews/${p.slug}/`}>Read review →</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
