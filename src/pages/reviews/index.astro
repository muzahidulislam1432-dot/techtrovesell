---
import {getCollection} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import Header from '../../components/Header.astro';import Footer from '../../components/Footer.astro';
const reviews=(await getCollection('reviews')).filter(x=>x.data.status==='published');
---
<BaseLayout title="Technology Reviews | TechTroveSell" description="Professional technology reviews with clear pros, cons and affiliate disclosures."><Header/><main><section class="archive-hero"><div class="container"><p class="eyebrow">Reviews</p><h1>Product reviews that explain the trade-offs.</h1></div></section><section class="section"><div class="container archive-grid">{reviews.map(r=><article class="archive-card"><img src={r.data.image} alt={r.data.imageAlt}/><div><p class="eyebrow">{r.data.category}</p><h2><a href={`/reviews/${r.data.slug}/`}>{r.data.title}</a></h2><p>{r.data.excerpt}</p><a class="text-link" href={`/reviews/${r.data.slug}/`}>Read review →</a></div></article>)}</div></section></main><Footer/></BaseLayout>
