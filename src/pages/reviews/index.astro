---
import {getCollection} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import Header from '../../components/Header.astro';import Footer from '../../components/Footer.astro';
const reviews=(await getCollection('reviews')).filter(x=>x.data.status==='published');
---
<BaseLayout title="Technology Reviews | TechTroveSell" description="Independent technology reviews with clear verdicts, trade-offs, specifications and transparent affiliate disclosures." canonical="https://techtrovesell.com/reviews/"><Header/><main id="main-content"><section class="archive-hero publication-archive"><div class="container"><p class="kicker">Technology reviews</p><h1>Products, tested through clear editorial standards.</h1><p>Every review explains who a product suits, where it falls short and what to verify before buying.</p></div></section><section class="section"><div class="container"><div class="archive-toolbar"><strong>{reviews.length} published review{reviews.length===1?'':'s'}</strong><a href="/editorial-policy/">Read our editorial policy →</a></div><div class="story-card-grid">{reviews.map(r=><article class="story-card"><a class="story-card-image" href={`/reviews/${r.data.slug}/`}><img src={r.data.image} alt={r.data.imageAlt}/></a><div class="story-card-body"><span class="story-label">{r.data.category}</span><h2><a href={`/reviews/${r.data.slug}/`}>{r.data.title}</a></h2><p>{r.data.excerpt}</p><div class="story-meta"><span>{r.data.brand||'Technology'}</span><span>Independent review</span></div><a class="text-link" href={`/reviews/${r.data.slug}/`}>Read review →</a></div></article>)}</div></div></section></main><Footer/></BaseLayout>
