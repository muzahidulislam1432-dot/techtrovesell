---
import {getCollection} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import Header from '../../components/Header.astro';import Footer from '../../components/Footer.astro';
const reviews=(await getCollection('reviews')).filter(x=>x.data.status==='published').map(x=>({type:'Review',title:x.data.title,summary:x.data.excerpt,url:`/reviews/${x.data.slug}/`,category:x.data.category}));
const guides=(await getCollection('guides')).filter(x=>x.data.status==='published').map(x=>({type:'Guide',title:x.data.title,summary:x.data.excerpt,url:`/buying-guides/${x.data.slug}/`,category:x.data.category}));
const comparisons=(await getCollection('comparisons')).filter(x=>x.data.status==='published').map(x=>({type:'Comparison',title:x.data.title,summary:x.data.excerpt,url:`/comparisons/${x.data.slug}/`,category:x.data.category}));const items=[...reviews,...guides,...comparisons];
---
<BaseLayout title="Search | TechTroveSell" description="Search reviews, buying guides and comparisons."><Header/><main><section class="archive-hero"><div class="container"><p class="eyebrow">Search</p><h1>Find a review, guide or comparison.</h1><input id="search-input" class="search-input" type="search" placeholder="Try: controller, keyboard, USB-C..."/></div></section><section class="section"><div class="container search-results">{items.map(i=><article class="search-card" data-search={`${i.title} ${i.summary} ${i.category}`.toLowerCase()}><span>{i.type} · {i.category}</span><h2><a href={i.url}>{i.title}</a></h2><p>{i.summary}</p></article>)}</div></section></main><script>const input=document.querySelector('#search-input'),cards=[...document.querySelectorAll('.search-card')];input?.addEventListener('input',e=>{const q=e.target.value.toLowerCase().trim();cards.forEach(c=>c.hidden=q&&!c.dataset.search.includes(q))});</script><Footer/></BaseLayout>
